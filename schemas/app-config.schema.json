{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Single HTML App configuration",
  "type": "object",
  "required": ["name", "slug", "version", "description", "license", "languages"],
  "properties": {
    "$schema": {"type": "string"},
    "name": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "description": {"type": "string", "minLength": 1},
    "author": {"type": "string"},
    "license": {"type": "string"},
    "languages": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": true
}
